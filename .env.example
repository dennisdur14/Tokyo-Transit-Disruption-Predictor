# Register for a free developer key at https://developer.odpt.org/
ODPT_API_KEY=your_odpt_consumer_key_here

# ODPT & Toei Bus GTFS-Realtime endpoints
ODPT_TRAIN_INFO_URL=https://api.odpt.org/api/v4/odpt:TrainInformation
TOEI_VEHICLE_POS_URL=https://api-public.odpt.org/api/v4/gtfs/realtime/ToeiBus_VehiclePosition
TOEI_TRIP_UPDATE_URL=https://api-public.odpt.org/api/v4/gtfs/realtime/ToeiBus_TripUpdate

# Database connection string (defaults to local SQLite; swap for PostgreSQL in production)
DATABASE_URL=sqlite:///data/tokyo_transit.db
